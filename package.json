{
  "name": "researchly",
  "version": "1.0.0",
  "private": true,
  "description": "Research.ly - A source-by-source research engine",
  "author": "live-by-unix",
  "license": "BSD-3-Clause",
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=worker",
    "build:frontend": "npm run build --workspace=frontend",
    "build:worker": "npm run build --workspace=worker",
    "test": "npm run test --workspace=frontend && npm run test --workspace=worker",
    "test:frontend": "npm run test --workspace=frontend",
    "test:worker": "npm run test --workspace=worker",
    "deploy:worker": "npm run deploy --workspace=worker",
    "deploy:pages": "npm run deploy --workspace=frontend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=worker"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
